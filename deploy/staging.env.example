# Classification: SECRET. Copy only into the approved staging secret manager; never commit populated values.
NUVRION_ENVIRONMENT=staging
NUVRION_RUNTIME_PROFILE=production
NUVRION_HOST=0.0.0.0
NUVRION_PORT=4100
NUVRION_TRUST_PROXY=true
NUVRION_IMAGE=registry.example.invalid/nuvrion@sha256:<64-hex-digest>
NUVRION_POSTGRES_IMAGE=postgres@sha256:<64-hex-digest>
NUVRION_RABBITMQ_IMAGE=rabbitmq@sha256:<64-hex-digest>
POSTGRES_DB=nuvrion
POSTGRES_USER=nuvrion
POSTGRES_PASSWORD=<secret-manager-reference>
RABBITMQ_DEFAULT_USER=nuvrion
RABBITMQ_DEFAULT_PASS=<secret-manager-reference>
NUVRION_DATABASE_URL=postgresql://nuvrion:<secret>@postgres/nuvrion
NUVRION_BROKER_URL=amqps://nuvrion:<secret>@rabbitmq
NUVRION_DB_POOL_SIZE=10
NUVRION_BOOTSTRAP_PASSWORD=<secret-manager-reference>
NUVRION_MASTER_KEY=<secret-manager-reference>
NUVRION_ACTIVE_ENCRYPTION_KEY_ID=<managed-key-id>
NUVRION_ENCRYPTION_KEYS=<secret-manager-json-object>
NUVRION_BACKUP_INTEGRITY_KEY=<secret-manager-reference>
NUVRION_AGENT_SIGNING_PRIVATE_KEY=<release-signing-service-reference>
NUVRION_AGENT_SIGNING_PUBLIC_KEY=<ed25519-public-key-pem>
NUVRION_AGENT_MAINTENANCE_MS=30000
NUVRION_AGENT_OFFLINE_MS=120000
NUVRION_LOGIN_ATTEMPT_LIMIT=5
NUVRION_LOGIN_WINDOW_MS=300000
