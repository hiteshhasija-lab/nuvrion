# Pinned by digest (Node 24.21.0, the version the running base image has) so a moved tag cannot change what is built; bump it deliberately.
FROM node:24-bookworm@sha256:22f6fe5f59fb7fed238b19623506d573dffaa932ce33b84ce541a9a2e0eade28

ENV NODE_ENV=production
ENV NUVRION_RUNTIME_PROFILE=production

WORKDIR /opt/nuvrion

# The lockfile pins every dependency (version, source and hash); npm ci installs exactly that and fails if it disagrees with package.json.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY apps ./apps
COPY modules ./modules
COPY providers ./providers
COPY contracts ./contracts
COPY database ./database
COPY tools ./tools

RUN chown -R node:node /opt/nuvrion

USER node
EXPOSE 4100
HEALTHCHECK CMD node -e "fetch('http://127.0.0.1:4100/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/api/src/server.js"]
