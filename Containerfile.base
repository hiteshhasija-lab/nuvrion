# Two stages, both pinned by digest so a moved tag cannot change what is built; bump them deliberately (and keep the Node version the same in both).
#
# build: the full Node image (Node 24.21.0), which has the compilers and Python that some dependencies use when they are installed
#   (ssh2 builds an optional native crypto module). Only /opt/nuvrion is taken from it.
# runtime: the slim image of the same Node version. It has no compilers, no Python, no image, XML or desktop libraries: about a tenth of
#   the packages and so a small fraction of the vulnerabilities the full image carries (see the image-scan job in CI). npm and corepack are
#   removed as well, because the application never runs them and their own bundled dependencies were the only fixable findings left.
FROM node:24-bookworm@sha256:22f6fe5f59fb7fed238b19623506d573dffaa932ce33b84ce541a9a2e0eade28 AS build

ENV NODE_ENV=production
ENV NUVRION_RUNTIME_PROFILE=production

WORKDIR /opt/nuvrion

# The lockfile pins every dependency (version, source and hash); npm ci installs exactly that and fails if it disagrees with package.json.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY apps ./apps
COPY modules ./modules
COPY providers ./providers
COPY contracts ./contracts
COPY database ./database
COPY tools ./tools

RUN chown -R node:node /opt/nuvrion

FROM node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20

ENV NODE_ENV=production
ENV NUVRION_RUNTIME_PROFILE=production

WORKDIR /opt/nuvrion
COPY --from=build --chown=node:node /opt/nuvrion /opt/nuvrion

# The application does not run a package manager. Removing it also removes the packages bundled inside it from the image.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

USER node
EXPOSE 4100
HEALTHCHECK CMD node -e "fetch('http://127.0.0.1:4100/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/api/src/server.js"]
